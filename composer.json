{
  "authors": [
    {
      "email": "dv.vostrikov@gmail.com",
      "name": "Dmitry Vostrikov"
    }
  ],
  "autoload": {
    "psr-4": {
      "CoreX\\Tenancy\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoreX\\Tenancy\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "description": "CoreX physical DB-per-account tenancy — root-schema control plane on stancl/tenancy v4 (B-11, D13).",
  "extra": {
    "laravel": {
      "providers": [
        "CoreX\\Tenancy\\TenancyServiceProvider"
      ]
    }
  },
  "keywords": [
    "laravel",
    "multi-tenancy",
    "stancl",
    "saas"
  ],
  "license": "MIT",
  "minimum-stability": "dev",
  "name": "corex/tenancy",
  "prefer-stable": true,
  "require": {
    "axiomasoft/stancl-jobpipeline": "2.0.0-alpha1",
    "axiomasoft/stancl-tenancy": "4.0.0-alpha1",
    "corex/core": "0.1.0-p4.3",
    "firebase/php-jwt": "^7.1",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "php": "^8.4"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0"
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "pint",
    "lint:check": "pint --test",
    "test": "pest"
  },
  "type": "library",
  "version": "0.1.0-p4.3"
}
